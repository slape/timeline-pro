import React, { useState, useEffect, useRef } from "react";
import TimelineLogger from "../../utils/logger";
import DatePickerModal from "./DatePickerModal";
import ItemContainer from "./ItemContainer";
import { getContainerStyles } from "../../functions/draggableItemStyles";
import { getShapeStyles } from "../../functions/getShapeStyles";
import "./DraggableBoardItem.css";
import { getDefaultRowFor } from "../../functions/getDefaultRowFor";
import { clamp } from "../../functions/clamp";
import { useDraggableItemState } from "../../hooks/useDraggableItemState";
import { useDateHandling } from "../../hooks/useDateHandling";
import { useMouseHandlers } from "../../hooks/useMouseHandlers";
import { useIsolatedZustandState } from "../../hooks/useIsolatedZustandState";
import { getItemColor } from "../../functions/itemColorUtils";
import { calculateInitialSize } from "../../functions/itemSizeUtils";
import handleItemNameChange from "../../functions/handleItemNameChange";
import handleSaveDate from "../../functions/handleSaveDate";
import mondaySdk from "monday-sdk-js";
import { LANE_HEIGHT, OFFSET_MAX } from "../../utils/configConstants";

const monday = mondaySdk();

/**
 * DraggableBoardItem component that renders a draggable item from monday.com board
 *
 * @param {Object} props - Component props
 * @param {Object} props.item - The board item data from monday.com
 * @param {string} props.item.id - Unique identifier for the item
 * @param {string} props.item.name - Name/title of the item
 * @param {Object} props.item.group - Group information for the item
 * @param {string} props.item.group.color - Color associated with the group
 * @param {Date} props.date - Date associated with the item
 * @param {string} props.shape - Shape of the item ('rectangle', 'circle')
 * @param {Function} props.onClick - Optional click handler
 * @param {Function} props.onLabelChange - Handler for label changes
 * @param {Function} props.onHideItem - Handler for hiding the item
 * @param {boolean} props.showItemDates - Whether to show editable date text
 * @param {Function} props.onPositionChange - Callback when item position changes (id, {x, y})
 * @returns {JSX.Element} - Draggable board item component
 */
const DraggableBoardItem = ({
  onClick,
  item,
  date,
  shape,
  onLabelChange,
  onHideItem,
  showItemDates,
  onPositionChange,
}) => {
  // Use custom hook for draggable item state management
  const {
    position,
    setPosition,
    isDragging,
    setIsDragging,
    isHovered,
    setIsHovered,
    dragStartPos,
    dragOffset,
    startSize,
    itemRef,
    containerRef,
  } = useDraggableItemState();

  // Use custom hook for date handling
  const { getFormattedDate } = useDateHandling(date);

  // Extract required data from props and store with stable references
  // Use a custom hook to isolate the state access and reduce rerenders
  const {
    context,
    settings,
    scale,
    currentPositionSetting,
    updateBoardItemDate,
    saveCustomItemY,
    itemPosition,
  } = useIsolatedZustandState(item.id);

  // Get position setting for bounds calculation
  const timelinePosition = settings?.position || "below";

  // Separate item position values for easier access (avoid direct object referencing)
  const itemRowShift = itemPosition.rowShift || 0;
  const itemLaneOffset = itemPosition.laneOffset || 0;

  // Create a stable reference to the position data to prevent child component rerenders
  // Use primitive values as dependencies to avoid reference issues
  const customItemY = React.useMemo(
    () => ({
      rowShift: itemRowShift,
      laneOffset: itemLaneOffset,
    }),
    [itemRowShift, itemLaneOffset],
  );

  const dragRef = useRef(null);
  const visualYRef = useRef(0);
  const elRef = useRef(null);
  // Initialize size using utility function
  const [size, setSize] = useState(() =>
    calculateInitialSize(shape, showItemDates, true),
  );

  // Date picker state
  const [isDatePickerOpen, setIsDatePickerOpen] = useState(false);
  const [selectedDate, setSelectedDate] = useState(date);

  // Date picker handlers
  const openDatePicker = (date) => {
    setSelectedDate(date);
    setIsDatePickerOpen(true);
  };

  const closeDatePicker = () => {
    setIsDatePickerOpen(false);
  };

  const handleDateChange = (newDate) => {
    setSelectedDate(newDate);
  };

  // Calculate initial position based on the item's date - only runs on mount
  useEffect(() => {
    if (itemRef.current && containerRef.current) {
      // Center the item horizontally by default (50% of the container)
      const initialX = 50;
      setPosition((prev) => ({
        x: initialX,
        y: prev.y,
      }));
      
      // Ensure item is positioned at exact stored location on mount
      const baseRow = getDefaultRowFor(item, currentPositionSetting);
      const row = baseRow + (customItemY.rowShift || 0);
      const offset = customItemY.laneOffset || 0;
      const initialY = row * LANE_HEIGHT + offset;
      
      // Apply exact position directly to avoid any initial jumps
      if (itemRef.current) {
        itemRef.current.style.transform = `translateY(${initialY}px)`;
        // Force immediate application
        void itemRef.current.getBoundingClientRect();
        
        // Also update the connector anchor
        const connectorAnchor = document.getElementById(`board-item-${item.id}`);
        if (connectorAnchor) {
          connectorAnchor.style.transform = `translateY(${initialY}px)`;
          void connectorAnchor.getBoundingClientRect();
        }
        
        TimelineLogger.debug("[POS] Item mounted with exact position", {
          itemId: item.id,
          baseRow,
          row,
          offset,
          initialY,
        });
      }
    }
  }, []); // Only run once on mount, size changes shouldn't affect this

  // Get item color using utility function
  const itemColor = getItemColor(item);

  // Format date using hook utility
  const formattedDate = getFormattedDate(date);

  // Memoize shape styles to prevent unnecessary recalculations
  const shapeStyles = React.useMemo(() => getShapeStyles(shape), [shape]);

  // Update size when shape or showItemDates changes
  // Memoize the size calculation to prevent unnecessary updates
  const calculatedSize = React.useMemo(
    () => calculateInitialSize(shape, showItemDates),
    [shape, showItemDates],
  );

  // Update size state only when the calculated size changes
  useEffect(() => {
    setSize(calculatedSize);
  }, [calculatedSize]);

  // Memoize container styles to prevent unnecessary recalculations
  const containerStyles = React.useMemo(
    () => getContainerStyles(position, size, isDragging),
    [position, size, isDragging],
  );

  // Row/Lane Shift drag handling system
  const onDragStart = (e) => {
    // Skip drag handling for click events
    if (e.type === "click") {
      return;
    }
    
    // Track initial mouse position to detect if this is a click or drag
    const initialMousePosition = { x: e.clientX, y: e.clientY };
    
    // Minimum movement needed to be considered a drag rather than a click
    const DRAG_THRESHOLD = 5; // pixels
    
    // We'll check the movement after a small delay
    let hasMovedEnough = false;
    
    // Create a function to check if the mouse has moved enough to be considered a drag
    const checkForDrag = (moveEvent) => {
      if (hasMovedEnough) return;
      
      const dx = Math.abs(moveEvent.clientX - initialMousePosition.x);
      const dy = Math.abs(moveEvent.clientY - initialMousePosition.y);
      
      // If the mouse has moved beyond the threshold, consider it a drag
      if (dx > DRAG_THRESHOLD || dy > DRAG_THRESHOLD) {
        hasMovedEnough = true;
        continueWithDrag();
      }
    };
    
    // Add a temporary move handler to check for movement
    document.addEventListener("mousemove", checkForDrag);
    
    // Remove the temporary handler after a short timeout if no significant movement
    const timeoutId = setTimeout(() => {
      document.removeEventListener("mousemove", checkForDrag);
      if (!hasMovedEnough) {
        // This was a click (or very small movement), not a drag
        TimelineLogger.debug(
          "[DRAG-DEBUG] Movement below threshold, treating as click",
          {
            itemId: item.id,
          },
        );
      }
    }, 300); // 300ms should be enough to detect intentional drags
    
    // Main drag logic
    const continueWithDrag = () => {
      clearTimeout(timeoutId);
      document.removeEventListener("mousemove", checkForDrag);
      
      // Get the current base row and custom position
      const baseRow = getDefaultRowFor(item, currentPositionSetting);
      const startRow = baseRow + (customItemY.rowShift || 0);
      const startLaneOffset = customItemY.laneOffset || 0;
      
      // Calculate the exact starting Y position based on current position
      const startY = startRow * LANE_HEIGHT + startLaneOffset;

      // Get the current visual position directly from the DOM
      const visualPosition = getVisualYPosition(elRef.current);
      
      // Use the actual visual position if available, otherwise use calculated position
      const currentTransform = visualPosition !== null ? visualPosition : startY;

      TimelineLogger.debug("[POS] Drag start: Position details", {
        itemId: item.id,
        baseRow,
        startRow,
        startLaneOffset,
        startY,
        visualPosition,
        currentTransform,
      });

      // Ensure the connector anchor is synchronized with the item
      const connectorAnchor = document.getElementById(`board-item-${item.id}`);
      if (connectorAnchor) {
        // Make sure the connector has the same transform as the item
        connectorAnchor.style.transform = `translateY(${currentTransform}px)`;
        // Force a repaint to ensure the connector is properly positioned
        void connectorAnchor.getBoundingClientRect();

        TimelineLogger.debug("[CONNECTOR] Prepared for drag", {
          itemId: item.id,
          position: connectorAnchor.getBoundingClientRect(),
          transform: connectorAnchor.style.transform,
        });
      }

      // Set starting visual position ref to match current DOM state
      visualYRef.current = currentTransform;

      dragRef.current = {
        pointerYStart: getPointerY(e),
        baseRow,
        startRow,
        startLaneOffset,
        startY,
        currentTransform,
        laneHeight: LANE_HEIGHT,
        scaleSnapshot: scale,
      };

      TimelineLogger.debug("[POS] Drag start: Row/Lane model", {
        itemId: item.id,
        baseRow,
        startRow,
        startLaneOffset,
        currentTransform,
        startY,
      });

      e.currentTarget.setPointerCapture?.(e.pointerId);
    };
  };

  // Helper function to update connector position during drag
  const updateConnectorPosition = (transformY = null, itemId = item.id) => {
    const connectorId = `board-item-${itemId}`;
    const connectorAnchor = document.getElementById(connectorId);

    if (connectorAnchor) {
      if (transformY === null) {
        // Reset the transform to empty string when null
        connectorAnchor.style.transform = "";
        // Force a repaint
        void connectorAnchor.offsetHeight;
        TimelineLogger.debug("[CONNECTOR] Reset transform", { itemId });
      } else {
        // Apply the transform when a value is provided
        connectorAnchor.style.transform = `translateY(${transformY}px)`;
        // Force a repaint by reading layout property to trigger recalc
        void connectorAnchor.getBoundingClientRect();
        TimelineLogger.debug("[CONNECTOR] Applied transform", {
          itemId,
          transformY,
        });
      }
    } else {
      TimelineLogger.debug("[CONNECTOR] Anchor not found", { connectorId });
    }
  };

  const onDragMove = (e) => {
    const s = dragRef.current;
    if (!s) return;
    
    // Calculate movement distance
    const currentPointerY = getPointerY(e);
    const moveDistance = Math.abs(currentPointerY - s.pointerYStart);
    
    // Don't start actual dragging until we've moved a certain amount
    // This prevents small accidental movements during clicks
    const DRAG_THRESHOLD = 5;
    if (moveDistance < DRAG_THRESHOLD) {
      // Just tracking movement but not actually moving yet
      return;
    }

    // Calculate movement in screen pixels first
    const dyScreen = currentPointerY - s.pointerYStart;
    
    // Convert to timeline coordinates based on current scale
    const dyTimeline = dyScreen / s.scaleSnapshot;

    // Start from the exact position that was captured at drag start
    // This is the key to preventing jumps
    const exactStartY = s.currentTransform;
    
    // Apply the movement to get the new position
    const newY = exactStartY + dyTimeline;
    
    // For debugging, calculate row and offset
    const newRow = Math.floor(newY / s.laneHeight);
    const rowOffset = newY - newRow * s.laneHeight;
    
    // Update the visual position reference
    visualYRef.current = newY;
    
    TimelineLogger.debug("[POS] Drag move: Movement calculation", {
      itemId: item.id,
      dyScreen,
      dyTimeline,
      exactStartY,
      newY,
      newRow,
      rowOffset,
    });

    // Apply the position to both the item and connector
    if (elRef.current) {
      // Set the exact position without any snapping or rounding
      elRef.current.style.transform = `translateY(${newY}px)`;
      
      // Apply the same exact position to the connector
      updateConnectorPosition(newY);
      
      // Force immediate update
      void elRef.current.getBoundingClientRect();
      
      // Notify other components that may need to update
      const updateEvent = new CustomEvent("timeline-position-changed", {
        bubbles: true,
        detail: { itemId: item.id },
      });
      document.dispatchEvent(updateEvent);
    }
  };

  const onDragEnd = () => {
    const s = dragRef.current;
    if (!s) return;

    // Get the exact final position that was last applied during drag
    const finalY = visualYRef.current;
    
    // Calculate row and lane offset for storage
    const finalRow = Math.floor(finalY / s.laneHeight);
    const rowShift = finalRow - s.baseRow;
    const laneOffset = finalY - finalRow * s.laneHeight;
    
    // Keep the exact visual position - don't recalculate or round it
    if (elRef.current) {
      // Lock in the exact final position
      elRef.current.style.transform = `translateY(${finalY}px)`;
      // Ensure immediate application
      void elRef.current.getBoundingClientRect();
    }
    
    TimelineLogger.debug("[POS] Drag end: Final position", {
      itemId: item.id,
      finalY,
      finalRow,
      baseRow: s.baseRow,
      rowShift,
      laneOffset,
    });

    // Only save if the position actually changed
    if (
      rowShift !== itemRowShift ||
      Math.abs(laneOffset - itemLaneOffset) > 1
    ) {
      // Create a stable position object
      const newPosition = {
        rowShift,
        laneOffset: parseFloat(laneOffset.toFixed(2)), // Prevent floating point issues
      };
      const itemIdCopy = item.id;

      // Save the position immediately (no timeout)
      saveCustomItemY(itemIdCopy, newPosition);
      
      // Keep the connector at the exact same position
      updateConnectorPosition(finalY, itemIdCopy);

      // Force a repaint
      void document.body.offsetHeight;

      // Dispatch an event to ensure other components update
      const updateEvent = new CustomEvent("timeline-position-changed", {
        bubbles: true,
        detail: { itemId: itemIdCopy },
      });
      document.dispatchEvent(updateEvent);

      // Additional updates to catch any late changes
      setTimeout(() => {
        // Keep the position exact
        if (elRef.current) {
          elRef.current.style.transform = `translateY(${finalY}px)`;
        }
        document.dispatchEvent(updateEvent);
      }, 50);
    } else {
      TimelineLogger.debug("[POS] Drag end: No significant position change", {
        itemId: item.id,
      });
    }

    dragRef.current = null;
  };

  function getPointerY(e) {
    return e.clientY ?? e.touches?.[0]?.clientY ?? 0;
  }

  // Create a stable callback for position changes
  const handlePositionChange = React.useCallback(
    (id, pos, isDragEnd) => {
      if (onPositionChange) {
        // Use a timeout to break the update cycle
        setTimeout(() => {
          onPositionChange(id, pos, isDragEnd);
        }, 10);
      }
    },
    [onPositionChange],
  );

  // Memoize the handler config to prevent recreation on every render
  const handlerConfig = React.useMemo(
    () => ({
      containerRef,
      dragStartPos,
      dragOffset,
      startSize,
      position: { x: position.x, y: position.y }, // Create a new object to avoid reference issues
      setPosition,
      size: { width: size.width, height: size.height }, // Create a new object to avoid reference issues
      setSize,
      setIsDragging,
      onPositionChange: handlePositionChange,
      item: item?.id ? { id: item.id } : null, // Only pass the ID to minimize dependencies
      timelinePosition,
    }),
    [
      // Only include primitive values or stable references
      position.x,
      position.y,
      size.width,
      size.height,
      timelinePosition,
      item?.id,
      handlePositionChange,
    ],
  );

  // Use custom hook for mouse handlers with memoized config
  const {
    handleMouseDown,
    handleMouseMove,
    handleMouseUp,
    handleResizeMouseDown,
  } = useMouseHandlers(handlerConfig);

  // Clean up event listeners on unmount or when handlers change
  // Use a stable cleanup function to avoid dependency issues
  const cleanup = React.useCallback(() => {
    document.removeEventListener("mousemove", handleMouseMove);
    document.removeEventListener("mouseup", handleMouseUp);
  }, [handleMouseMove, handleMouseUp]);

  useEffect(() => {
    return cleanup;
  }, [cleanup]);

  // Create a stable mouseDown handler
  const itemMouseDown = React.useCallback(
    (e) => {
      // Prevent accidental movements by checking if this is a simple click vs drag
      if (e.type === "click") {
        // For click events, don't trigger drag behavior
        e.stopPropagation();
        return;
      }
      
      TimelineLogger.debug(
        "[DRAG-DEBUG] handleMouseDown fired in ItemContainer",
        { itemId: item.id },
      );
      handleMouseDown(e);
    },
    [handleMouseDown, item.id],
  );

  // Handle item name change
  const handleNameChange = async (newName) => {
    await handleItemNameChange({
      newName,
      item,
      context,
      monday,
      onLabelChange,
    });
  };

  // Handle opening the date picker modal
  const handleOpenDatePicker = () => {
    openDatePicker(date);
  };

  // Handle saving the selected date
  const handleSaveDateWrapper = () => {
    return handleSaveDate({
      item,
      selectedDate,
      settings,
      context,
      monday,
      updateBoardItemDate,
      setIsDatePickerOpen,
      setSelectedDate,
      onLabelChange,
      date,
    });
  };

  return (
    <div
      ref={(el) => {
        itemRef.current = el;
        elRef.current = el; // Set both refs to the same element
        // Also set the container ref when the element mounts/updates
        if (el) {
          containerRef.current = el.closest(".timeline-container");
        }
      }}
      style={containerStyles}
      onMouseEnter={() => setIsHovered(true)}
      onMouseLeave={() => setIsHovered(false)}
      onPointerDown={onDragStart}
      onPointerMove={onDragMove}
      onPointerUp={onDragEnd}
    >
      <ItemContainer
        shape={shape}
        isDragging={isDragging}
        itemColor={itemColor}
        shapeStyles={shapeStyles}
        onClick={onClick}
        isHovered={isHovered}
        onHideItem={onHideItem}
        item={item}
        handleResizeMouseDown={handleResizeMouseDown}
        showItemDates={showItemDates}
        formattedDate={formattedDate}
        handleNameChange={handleNameChange}
        handleMouseDown={itemMouseDown}
        handleOpenDatePicker={handleOpenDatePicker}
      />

      {/* Date Picker Modal */}
      <DatePickerModal
        isOpen={isDatePickerOpen}
        onClose={closeDatePicker}
        item={item}
        selectedDate={selectedDate}
        onDateChange={handleDateChange}
        onSave={handleSaveDateWrapper}
      />
    </div>
  );
};

export default React.memo(DraggableBoardItem);
